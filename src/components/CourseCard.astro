---
import type { Course } from "@/content/courses";

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<article class="card-glass overflow-hidden">
  <img src={course.image} alt={course.alt} class="h-52 w-full object-cover" loading="lazy" />
  <div class="p-6">
    <h3 class="display-title text-2xl font-semibold text-white">{course.title}</h3>
    <p class="mt-3 text-sm text-slate-300">{course.shortDescription}</p>
    <a href={`/courses#${course.id}`} class="mt-5 inline-block text-sm font-semibold text-cyan-300 hover:text-cyan-200">
      View course details ->
    </a>
  </div>
</article>
