---
import { contactDetails } from "@/content/courses";
---

<footer class="border-t border-white/10 bg-[#0A1420] py-10">
  <div class="container-wide grid gap-6 md:grid-cols-2">
    <div>
      <p class="display-title text-lg text-white">Firstcare Training</p>
      <p class="mt-2 max-w-xl text-sm text-slate-400">
        Accredited emergency care and fire safety training for teams across George and the wider Garden Route.
      </p>
      <p class="mt-4 text-xs text-slate-500">
        Training division of
        <a class="text-cyan-300 hover:underline" href="https://wildfiresupport.org.za" target="_blank" rel="noreferrer">Firstcare Wildfire Support</a>.
      </p>
    </div>
    <div class="text-sm text-slate-300 md:text-right">
      <p>{contactDetails.phonePrimary} | {contactDetails.phoneSecondary}</p>
      <p class="mt-1">{contactDetails.email}</p>
      <p class="mt-1">{contactDetails.location}</p>
    </div>
  </div>
</footer>
