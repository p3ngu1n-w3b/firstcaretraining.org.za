---
import { heroCopy } from "@/content/courses";
---

<section class="grain relative isolate flex min-h-[82vh] items-center overflow-hidden border-b border-white/10">
  <img
    src="/images/hero-training.webp"
    alt="Emergency training session in progress"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-[#060D14] via-[#060D14]/85 to-[#060D14]/35"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-[#060D14] via-transparent to-[#060D14]/35"></div>
  <div class="absolute -left-20 top-28 h-72 w-72 rounded-full bg-cyan-300/15 blur-[120px]"></div>
  <div class="container-wide relative z-10 py-20">
    <span class="eyebrow">{heroCopy.eyebrow}</span>
    <h1 class="display-title mt-6 max-w-3xl text-5xl font-bold leading-[0.96] text-white md:text-7xl">
      Train with <span class="text-gradient-pulse">Confidence</span>.<br />
      Respond with Skill.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-200">{heroCopy.subheading}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={heroCopy.primaryCta.href} class="btn-pulse">{heroCopy.primaryCta.label}</a>
      <a href={heroCopy.secondaryCta.href} class="btn-ghost">{heroCopy.secondaryCta.label}</a>
    </div>
    <p class="mt-7 text-sm text-slate-300">{heroCopy.trustLine}</p>
  </div>
</section>
