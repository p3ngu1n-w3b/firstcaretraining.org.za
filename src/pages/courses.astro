---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CourseAccordion from "@/components/CourseAccordion.astro";
import CTABanner from "@/components/CTABanner.astro";
import { courseSchema } from "@/content/courses";
---

<BaseLayout
  title="Safety and Emergency Training Courses | Firstcare Training"
  description="Explore accredited first aid, fire marshal, wildfire safety, and snake awareness training courses in George and the Garden Route."
  canonicalPath="/courses"
  jsonLd={courseSchema}
>
  <section class="border-b border-white/10 bg-[#0A1420] py-16">
    <div class="container-wide">
      <p class="eyebrow">Courses Hub</p>
      <h1 class="display-title mt-5 max-w-4xl text-5xl font-bold text-white">Safety and Emergency Training Courses</h1>
      <p class="mt-4 max-w-3xl text-slate-300">
        Professional emergency training for workplace compliance, farm safety, and community preparedness across the Garden Route and Western Cape.
      </p>
      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        <a class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-cyan-300 hover:text-cyan-200" href="#first-aid">First Aid</a>
        <a class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-cyan-300 hover:text-cyan-200" href="#fire-marshal">Fire Marshal</a>
        <a class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-cyan-300 hover:text-cyan-200" href="#wildfire">Wildfire</a>
        <a class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-cyan-300 hover:text-cyan-200" href="#snake-awareness">Snake Awareness</a>
        <a class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-cyan-300 hover:text-cyan-200" href="#workshops">Workshops</a>
      </div>
    </div>
  </section>

  <CourseAccordion />
  <CTABanner />
</BaseLayout>
